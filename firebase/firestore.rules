rules_version = '2';

// Firestore — regras de segurança. Cole em Firestore > Regras.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validRating() {
      return request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 10;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if request.auth.uid == uid;
    }

    match /tags/{tagId} {
      allow read: if signedIn();
      // id da tag = nome em minúsculas, evita duplicatas
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // permite exclusão de tags órfãs (quando nenhum local mais as utiliza)
      allow delete: if signedIn();
    }

    match /places/{placeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // criador edita; qualquer logado pode atualizar agregados (média/contagem) ou votos de exclusão (deleteVotes)
      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ratingSum', 'reviewCount', 'avgRating', 'deleteVotes'])
      );
      // permite exclusão por qualquer usuário autenticado quando o limiar de votação (>50%) é atingido
      allow delete: if signedIn();

      // id da avaliação = uid do autor → uma avaliação por usuário (editável)
      match /reviews/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid && validRating();
        allow delete: if signedIn();
      }
    }
  }
}
